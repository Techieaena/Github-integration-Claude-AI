{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/semanticmodel/1.0/schema.json",
  "metadata": {
    "type": "TableDefinitions",
    "displayName": "tables",
    "description": "TMDL table definitions for Star Schema (3 dimensions + 1 fact table)",
    "version": "1.0"
  },
  "config": {
    "tables": [
      {
        "name": "DimCustomer",
        "type": "Dimension",
        "rows": 25000,
        "columns": 11
      },
      {
        "name": "DimProduct",
        "type": "Dimension",
        "rows": 1175,
        "columns": 9
      },
      {
        "name": "DimDate",
        "type": "Dimension",
        "rows": 3650,
        "columns": 10
      },
      {
        "name": "FactSales",
        "type": "Fact",
        "rows": 138116,
        "columns": 28
      },
      {
        "name": "Measures",
        "type": "Calculation",
        "measures": 30
      }
    ],
    "owner": "Analytics Team"
  }
}
