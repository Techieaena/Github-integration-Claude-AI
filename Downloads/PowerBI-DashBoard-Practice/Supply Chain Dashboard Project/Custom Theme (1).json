{
  "name": "Custom Theme",
  "dataColors": [
    "#2619cb",
    "#4180fb",
    "#5e8d38",
    "#e3f1ba",
    "#0a561c"
  ],
  "foreground": "#111827",
  "background": "#e9e8fa",
  "foregroundNeutralSecondary": "#6b7280",
  "backgroundLight": "#d4d1f5",
  "foregroundNeutralTertiary": "#6b7280",
  "backgroundNeutral": "#f4f4fc",
  "tableAccent": "#2619cb",
  "maximum": "#5e8d38",
  "center": "#4180fb",
  "minimum": "#2619cb",
  "bad": "#2619cb",
  "neutral": "#4180fb",
  "good": "#5e8d38",
  "textClasses": {
    "callout": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "title": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "header": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "label": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f4f4fc"
              }
            }
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#f4f4fc"
              }
            },
            "show": true,
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#f4f4fc"
              }
            },
            "border": {
              "solid": {
                "color": "#f4f4fc"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#d4d1f5"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#e9e8fa"
              }
            },
            "transparency": 0
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#ececec"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}