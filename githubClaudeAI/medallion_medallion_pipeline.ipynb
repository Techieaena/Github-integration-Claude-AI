{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# E-Commerce Medallion Architecture Pipeline\n",
        "## Bronze → Silver → Gold Transformation\n",
        "\n",
        "**Dataset**: E-commerce Sales and Customer Analytics (Kaggle)\n",
        "**Lakehouse**: githubclaude\n",
        "**Workspace**: fabricaena\n",
        "\n",
        "### Architecture:\n",
        "- **Bronze Layer**: Raw CSV files from Kaggle\n",
        "- **Silver Layer**: Cleaned, deduplicated data with transformations\n",
        "- **Gold Layer**: Business analytics and aggregations\n",
        "\n",
        "---"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Install Dependencies & Setup"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Install kagglehub\n        "import subprocess\n",
        "import sys\n",
        "\n",
        "subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"kagglehub\", \"-q\"])\n",
        "\n",
        "print(\"✓ Dependencies installed\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Configuration\n",
        "from datetime import datetime\n",
        "import os\n",
        "import pandas as pd\n",
        "from pyspark.sql import SparkSession\n",
        "from pyspark.sql.functions import *\n",
        "\n",
        "# Workspace & Lakehouse Configuration\n",
        "WORKSPACE_NAME = \"fabricaena\"\n",
        "LAKEHOUSE_NAME = \"githubclaude\"\n",
        "WORKSPACE_ID = \"9c06c853-c4ee-42ad-b784-9ad3c80e7f1d\"\n",
        "LAKEHOUSE_ID = \"0b4f9e6c-379c-493f-b707-0c857c8b8041\"\n",
        "\n",
        "# OneLake ABFSS Path\n",
        "ABFSS_PATH = f\"abfss://Files@onelake.dfs.core.windows.net/{WORKSPACE_ID}/{LAKEHOUSE_ID}/Files\"\n",
        "\n",
        "# Layer Paths\n",
        "BRONZE_PATH = f\"{ABFSS_PATH}/Bronze\"\n",
        "SILVER_PATH = f\"{ABFSS_PATH}/Silver\"\n",
        "GOLD_PATH = f\"{ABFSS_PATH}/Gold\"\n",
        "DOCS_PATH = f\"{ABFSS_PATH}/Documentation\"\n",
        "\n",
        "# Kaggle Dataset\n",
        "KAGGLE_DATASET = \"datascikhan/e-commerce-sales-and-customer-analytics\"\n",
        "\n",
        "print(\"✓ Configuration loaded\")\n",
        "print(f\"\\nWorkspace: {WORKSPACE_NAME}\")\n",
        "print(f\"Lakehouse: {LAKEHOUSE_NAME}\")\n",
        "print(f\"ABFSS Path: {ABFSS_PATH}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Download Kaggle Dataset"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import kagglehub\n",
        "\n",
        "print(f\"Downloading dataset: {KAGGLE_DATASET}...\")\n",
        "dataset_path = kagglehub.dataset_download(KAGGLE_DATASET)\n",
        "\n",
        "print(f\"✓ Dataset downloaded to: {dataset_path}\")\n",
        "\n",
        "# List files\n",
        "files = os.listdir(dataset_path)\n",
        "print(f\"\\nFiles in dataset:\")\n",
        "for f in files:\n",
        "    file_path = os.path.join(dataset_path, f)\n",
        "    size_mb = os.path.getsize(file_path) / (1024*1024)\n",
        "    print(f\"  - {f} ({size_mb:.2f} MB)\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Analyze Dataset Structure"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Analyze each CSV file\n",
        "csv_files = [f for f in files if f.endswith('.csv')]\n",
        "\n",
        "dataset_schema = {}\n",
        "\n",
        "for filename in csv_files:\n",
        "    filepath = os.path.join(dataset_path, filename)\n",
        "    df = pd.read_csv(filepath)\n",
        "    \n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(f\"FILE: {filename}\")\n",
        "    print(f\"{'='*80}\")\n",
        "    print(f\"Shape: {df.shape[0]:,} rows × {df.shape[1]} columns\")\n",
        "    print(f\"\\nColumns and Data Types:\")\n",
        "    \n",
        "    col_info = []\n",
        "    for col in df.columns:\n",
        "        null_count = df[col].isnull().sum()\n",
        "        col_info.append(f\"  - {col}: {df[col].dtype} (nulls: {null_count})\")\n",
        "    \n",
        "    for info in col_info:\n",
        "        print(info)\n",
        "    \n",
        "    dataset_schema[filename] = {\n",
        "        'rows': df.shape[0],\n",
        "        'columns': list(df.columns),\n",
        "        'dtypes': df.dtypes.to_dict(),\n",
        "        'nulls': df.isnull().sum().to_dict()\n",
        "    }\n",
        "\n",
        "print(\"\\n✓ Dataset analysis complete\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Create Documentation Files"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Create schema documentation\n",
        "schema_doc = f\"\"\"# E-Commerce Dataset Schema Documentation\n",
        "\n",
        "Generated: {datetime.now().isoformat()}\n",
        "\n",
        "## Dataset Overview\n",
        "This dataset contains comprehensive e-commerce sales and customer analytics data.\n",
        "\n",
        "### Files Summary:\n",
        "\"\"\"\n",
        "\n",
        "for filename, schema in dataset_schema.items():\n",
        "    schema_doc += f\"\\n### {filename}\\n\"\n",
        "    schema_doc += f\"- **Rows**: {schema['rows']:,}\\n\"\n",
        "    schema_doc += f\"- **Columns**: {schema['columns']}\\n\\n\"\n",
        "    schema_doc += \"**Column Details:**\\n\"\n",
        "    for col in schema['columns']:\n",
        "        dtype = str(schema['dtypes'].get(col, 'unknown'))\n",
        "        nulls = schema['nulls'].get(col, 0)\n",
        "        schema_doc += f\"- `{col}` ({dtype})\" + (f\" - {nulls} nulls\" if nulls > 0 else \"\") + \"\\n\"\n",
        "\n",
        "print(\"Schema Documentation:\")\n",
        "print(schema_doc[:500] + \"...\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Create README file\n",
        "readme = f\"\"\"E-COMMERCE SALES AND CUSTOMER ANALYTICS DATASET\n",
        "{'='*60}\n",
        "\n",
        "MEDALLION ARCHITECTURE IMPLEMENTATION\n",
        "{'-'*60}\n",
        "\n",
        "BRONZE LAYER (Raw Data)\n",
        "{'-'*40}\n",
        "Contains raw CSV files imported directly from Kaggle without transformations.\n",
        "\n",
        "Files:\n",
        "\"\"\"\n",
        "\n",
        "for filename in csv_files:\n",
        "    filepath = os.path.join(dataset_path, filename)\n",
        "    size_mb = os.path.getsize(filepath) / (1024*1024)\n",
        "    rows = dataset_schema[filename]['rows']\n",
        "    readme += f\"  • {filename}\\n\"\n",
        "    readme += f\"    - Size: {size_mb:.2f} MB\\n\"\n",
        "    readme += f\"    - Rows: {rows:,}\\n\"\n",
        "\n",
        "readme += f\"\"\"\\n\n\n",
        "SILVER LAYER (Cleaned & Transformed)\n",
        "{'-'*40}\n",
        "Transformations Applied:\n",
        "  ✓ Data type conversions and standardization\n",
        "  ✓ Null/missing value handling\n",
        "  ✓ Duplicate record removal\n",
        "  ✓ Date/time normalization\n",
        "  ✓ Referential integrity validation\n",
        "  ✓ Business rule enforcement\n",
        "\n",
        "Output Format: Delta (Parquet-based)\n",
        "\n",
        "Tables:\n",
        "  • dim_customer_silver - Customer dimension table\n",
        "  • fact_sales_silver - Sales transactions\n",
        "  • dim_product_silver - Product dimension\n",
        "  • fact_order_items_silver - Order line items\n",
        "\n",
        "\n\n",
        "GOLD LAYER (Business Analytics)\n",
        "{'-'*40}\n",
        "Analytical Views & Aggregations:\n",
        "  • Customer Segmentation - RFM Analysis\n",
        "  • Sales Performance by Category\n",
        "  • Monthly Revenue Trends\n",
        "  • Top Products & Best Sellers\n",
        "  • Customer Lifetime Value\n",
        "  • Order Patterns & Frequency\n",
        "\n",
        "Output Format: Delta (Parquet-based)\n",
        "\n",
        "\n\n",
        "TRANSFORMATION FLOW\n",
        "{'-'*40}\n",
        "\n",
        "Raw Data (Kaggle)\n",
        "        ↓\n",
        "   BRONZE (CSV Files)\n",
        "        ↓\n",
        "   [PySpark Transformation]\n",
        "        ↓\n",
        "   SILVER (Delta Tables - Cleaned Data)\n",
        "        ↓\n",
        "   [SQL Aggregations & Analytics]\n",
        "        ↓\n",
        "   GOLD (Delta Tables - Business Metrics)\n",
        "\n",
        "\n\n",
        "TECHNICAL DETAILS\n",
        "{'-'*40}\n",
        "• Storage Format: Delta Lake (ACID transactions, time travel)\n",
        "• Compute Engine: Apache Spark\n",
        "• Location: OneLake (Unified Data Lake)\n",
        "• Lakehouse: githubclaude\n",
        "• Workspace: fabricaena\n",
        "\n",
        "\n\n",
        "NEXT STEPS\n",
        "{'-'*40}\n",
        "1. Run Bronze Layer Upload (below)\n",
        "2. Run Silver Layer Transformation\n",
        "3. Create Gold Layer Views in SQL Analytical Endpoint\n",
        "4. Create Power BI Dashboards against Gold Layer\n",
        "\n",
        "Generated: {datetime.now().isoformat()}\n",
        "\"\"\"\n",
        "\n",
        "print(\"README Created (first 500 chars):\")\n",
        "print(readme[:500] + \"...\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Upload to Bronze Layer"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pyspark.sql import SparkSession\n",
        "\n",
        "spark = SparkSession.builder.appName(\"BronzeUpload\").getOrCreate()\n",
        "\n",
        "print(f\"Uploading CSV files to Bronze layer: {BRONZE_PATH}\\n\")\n",
        "\n",
        "# Upload each CSV file to Bronze\n",
        "for filename in csv_files:\n",
        "    filepath = os.path.join(dataset_path, filename)\n",
        "    table_name = filename.replace('.csv', '')\n",
        "    \n",
        "    print(f\"Processing: {filename}...\")\n",
        "    \n",
        "    # Read CSV with Spark\n",
        "    df = spark.read.format(\"csv\").option(\"header\", \"true\").option(\"inferSchema\", \"true\").load(filepath)\n",
        "    \n",
        "    # Show schema\n",
        "    print(f\"  Rows: {df.count():,}, Columns: {len(df.columns)}\")\n",
        "    \n",
        "    # Write to Bronze layer (parquet for now, will be delta)\n",
        "    bronze_table_path = f\"{BRONZE_PATH}/{table_name}\"\n",
        "    df.write.format(\"parquet\").mode(\"overwrite\").save(bronze_table_path)\n",
        "    \n",
        "    print(f\"  ✓ Uploaded to: {bronze_table_path}\\n\")\n",
        "\n",
        "print(\"✓ Bronze layer upload complete!\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Silver Layer Transformation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(f\"Transforming data to Silver layer: {SILVER_PATH}\\n\")\n",
        "\n",
        "# Read Bronze data\n",
        "print(\"Reading Bronze layer files...\")\n",
        "customer_bronze = spark.read.format(\"parquet\").load(f\"{BRONZE_PATH}/customer_master\")\n",
        "sales_bronze = spark.read.format(\"parquet\").load(f\"{BRONZE_PATH}/ecommerce_sales_customer_analytics_150k\")\n",
        "order_items_bronze = spark.read.format(\"parquet\").load(f\"{BRONZE_PATH}/order_items\")\n",
        "products_bronze = spark.read.format(\"parquet\").load(f\"{BRONZE_PATH}/product_catalog\")\n",
        "\n",
        "print(\"✓ Bronze files loaded\\n\")\n",
        "\n",
        "# Transform Customer Data\n",
        "print(\"Transforming customer data...\")\n",
        "customer_silver = (customer_bronze\n",
        "    .dropDuplicates()\n",
        "    .withColumn(\"processed_date\", current_timestamp())\n",
        "    .withColumn(\"load_id\", lit(datetime.now().strftime(\"%Y%m%d_%H%M%S\")))\n",
        "    .filter(col(\"CustomerID\").isNotNull())\n",
        ")\n",
        "print(f\"  Rows: {customer_silver.count():,}\")\n",
        "\n",
        "# Transform Sales Data\n",
        "print(\"Transforming sales data...\")\n",
        "sales_silver = (sales_bronze\n",
        "    .dropDuplicates()\n",
        "    .withColumn(\"processed_date\", current_timestamp())\n",
        "    .withColumn(\"load_id\", lit(datetime.now().strftime(\"%Y%m%d_%H%M%S\")))\n",
        "    .filter((col(\"OrderID\").isNotNull()) & (col(\"CustomerID\").isNotNull()))\n",
        ")\n",
        "print(f\"  Rows: {sales_silver.count():,}\")\n",
        "\n",
        "# Transform Order Items\n",
        "print(\"Transforming order items...\")\n",
        "order_items_silver = (order_items_bronze\n",
        "    .dropDuplicates()\n",
        "    .withColumn(\"processed_date\", current_timestamp())\n",
        "    .withColumn(\"load_id\", lit(datetime.now().strftime(\"%Y%m%d_%H%M%S\")))\n",
        "    .filter((col(\"OrderID\").isNotNull()) & (col(\"ProductID\").isNotNull()))\n",
        ")\n",
        "print(f\"  Rows: {order_items_silver.count():,}\")\n",
        "\n",
        "# Transform Products\n",
        "print(\"Transforming product data...\")\n",
        "products_silver = (products_bronze\n",
        "    .dropDuplicates()\n",
        "    .withColumn(\"processed_date\", current_timestamp())\n",
        "    .withColumn(\"load_id\", lit(datetime.now().strftime(\"%Y%m%d_%H%M%S\")))\n",
        "    .filter(col(\"ProductID\").isNotNull())\n",
        ")\n",
        "print(f\"  Rows: {products_silver.count():,}\")\n",
        "\n",
        "print(\"\\n✓ All transformations complete\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Write to Silver layer (Delta format)\n",
        "print(f\"Writing to Silver layer...\\n\")\n",
        "\n",
        "print(\"Writing customer_silver...\")\n",
        "customer_silver.write.format(\"delta\").mode(\"overwrite\").save(f\"{SILVER_PATH}/customer_silver\")\n",
        "print(f\"  ✓ Saved to {SILVER_PATH}/customer_silver\")\n",
        "\n",
        "print(\"Writing sales_silver...\")\n",
        "sales_silver.write.format(\"delta\").mode(\"overwrite\").save(f\"{SILVER_PATH}/sales_silver\")\n",
        "print(f\"  ✓ Saved to {SILVER_PATH}/sales_silver\")\n",
        "\n",
        "print(\"Writing order_items_silver...\")\n",
        "order_items_silver.write.format(\"delta\").mode(\"overwrite\").save(f\"{SILVER_PATH}/order_items_silver\")\n",
        "print(f\"  ✓ Saved to {SILVER_PATH}/order_items_silver\")\n",
        "\n",
        "print(\"Writing products_silver...\")\n",
        "products_silver.write.format(\"delta\").mode(\"overwrite\").save(f\"{SILVER_PATH}/products_silver\")\n",
        "print(f\"  ✓ Saved to {SILVER_PATH}/products_silver\")\n",
        "\n",
        "print(\"\\n✓ Silver layer upload complete!\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Save Documentation to Gold Layer"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Save documentation files\n",
        "import json\n",
        "\n",
        "print(\"Creating documentation files...\\n\")\n",
        "\n",
        "# Save schema doc as text\n",
        "from pyspark.dbutils import DBUtils\n",
        "dbutils = DBUtils(spark)\n",
        "\n",
        "# Create markdown documentation\n",
        "dbutils.fs.put(f\"{DOCS_PATH}/dataset_schema.md\", schema_doc, overwrite=True)\n",
        "print(\"✓ Saved dataset_schema.md\")\n",
        "\n",
        "# Create README\n",
        "dbutils.fs.put(f\"{DOCS_PATH}/README.txt\", readme, overwrite=True)\n",
        "print(\"✓ Saved README.txt\")\n",
        "\n",
        "# Save schema as JSON\n",
        "schema_json = json.dumps(dataset_schema, indent=2, default=str)\n",
        "dbutils.fs.put(f\"{DOCS_PATH}/schema.json\", schema_json, overwrite=True)\n",
        "print(\"✓ Saved schema.json\")\n",
        "\n",
        "print(f\"\\n✓ Documentation saved to: {DOCS_PATH}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 8. Summary & Next Steps"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"MEDALLION ARCHITECTURE PIPELINE - COMPLETE\")\n",
        "print(\"=\"*80)\n",
        "\n",
        "print(\"\\n✓ BRONZE LAYER (Raw Data)\")\n",
        "print(f\"  Location: {BRONZE_PATH}\")\n",
        "print(f\"  Files: {len(csv_files)} CSV files uploaded as Parquet\")\n",
        "for filename in csv_files:\n",
        "    rows = dataset_schema[filename]['rows']\n",
        "    print(f\"    - {filename}: {rows:,} rows\")\n",
        "\n",
        "print(\"\\n✓ SILVER LAYER (Cleaned Data)\")\n",
        "print(f\"  Location: {SILVER_PATH}\")\n",
        "print(f\"  Format: Delta Lake\")\n",
        "print(f\"  Tables:\")\n",
        "print(f\"    - customer_silver\")\n",
        "print(f\"    - sales_silver\")\n",
        "print(f\"    - order_items_silver\")\n",
        "print(f\"    - products_silver\")\n",
        "\n",
        "print(\"\\n✓ DOCUMENTATION\")\n",
        "print(f\"  Location: {DOCS_PATH}\")\n",
        "print(f\"    - dataset_schema.md\")\n",
        "print(f\"    - README.txt\")\n",
        "print(f\"    - schema.json\")\n",
        "\n",
        "print(\"\\n\" + \"-\"*80)\n",
        "print(\"NEXT STEPS:\")\n",
        "print(\"-\"*80)\n",
        "print(\"\\n1. Create Gold Layer using SQL Analytical Endpoint:\")\n",
        "print(\"   - Run: gold_layer_transformation.sql\")\n",
        "print(\"   - Creates dimensional and fact tables\")\n",
        "print(\"   - Builds analytical views and aggregations\")\n",
        "\n",
        "print(\"\\n2. Connect Power BI Dashboard:\")\n",
        "print(\"   - Use Gold layer tables for visualizations\")\n",
        "print(\"   - Build KPI dashboards\")\n",
        "\n",
        "print(\"\\n3. Schedule Notebook Execution:\")\n",
        "print(\"   - Set up automatic refresh schedule\")\n",
        "print(\"   - Monitor data quality and transformations\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(f\"Pipeline executed at: {datetime.now().isoformat()}\")\n",
        "print(\"=\"*80)"
      ]
    }
  ],
